# frontend/.env.prod.frontend
# Variables available to your frontend at runtime.

# The public URL where the frontend will call your backend
NEXT_PUBLIC_API_URL=https://api.sajanshah.com/api

# The domain where your frontend is hosted
NEXT_PUBLIC_SITE_URL=https://sajanshah.com

# Razorpay public key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxx
