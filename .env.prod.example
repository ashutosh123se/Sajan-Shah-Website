# .env.prod.example (Place this at the root of your project as just `.env` on your server)
# These variables are used directly by docker-compose.prod.yml during the build and setup process

# A strong secure password for your production MySQL database
DB_PASSWORD=YOUR_STRONG_SECURE_PASSWORD

# The public URL where the frontend will call your backend (Must match where your backend is hosted)
NEXT_PUBLIC_API_URL=https://api.sajanshah.com/api
