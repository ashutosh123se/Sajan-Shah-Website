# backend/.env.prod
# These variables are injected directly into the backend container

# Keep this as 'db' because that is the container name in docker-compose.prod.yml
# Update YOUR_STRONG_SECURE_PASSWORD to match the one in your root .env file
DATABASE_URL=mysql://root:YOUR_STRONG_SECURE_PASSWORD@db:3306/ss_website_db

PORT=5001
NODE_ENV=production

# The domain where your frontend is hosted (needed for CORS)
FRONTEND_URL=https://sajanshah.com

# Authentication
JWT_SECRET=your_jwt_secret_min_32_chars_CHANGE_THIS
JWT_REFRESH_SECRET=your_refresh_secret_DIFFERENT_FROM_ABOVE

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="Sajan Shah <your@gmail.com>"
ADMIN_EMAIL=admin@sajanshah.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
