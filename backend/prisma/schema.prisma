generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SHOP_MANAGER
  SUBSCRIBER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  photoUrl     String?
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  orders       Order[]
}

model Product {
  id                 String      @id @default(cuid())
  title              String
  description        String
  price              Float
  imageUrl           String
  images             String[]
  category           String      // books | merchandise | courses | posters | bands | ai | bundles
  tags               String[]
  stock              Int?
  isActive           Boolean     @default(true)
  isFeatured         Boolean     @default(false)
  cloudinaryPublicId String?
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]
}

model Event {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique @default("")
  description        String?
  posterUrl          String
  cloudinaryPublicId String
  webinarUrl         String
  eventDate          DateTime
  city               String?
  venue              String?
  eventType          String?  // school | corporate | public | online
  isPast             Boolean  @default(false)
  isFree             Boolean  @default(true)
  price              Float?
  capacity           Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Member {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  photoUrl           String
  cloudinaryPublicId String?
  bio                String
  tier               String   // Gold | Silver | Community
  joinedAt           DateTime @default(now())
}

model MemberApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  bio       String
  whyJoin   String
  status    String   @default("PENDING")
  appliedAt DateTime @default(now())
}

model Contributor {
  id                 String @id @default(cuid())
  name               String
  photoUrl           String
  cloudinaryPublicId String?
  role               String
  description        String
  order              Int    @default(0)
}

model Program {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String
  pitch          String
  price          Float
  currency       String   @default("INR")
  thumbnailUrl   String?
  videoUrl       String?
  curriculum     String
  targetAudience String[]
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Contact {
  id           String    @id @default(cuid())
  name         String
  organization String?
  email        String
  phone        String?
  city         String?
  eventType    String?
  eventDate    DateTime?
  audience     String?
  message      String
  formType     String    @default("inquiry")
  isRead       Boolean   @default(false)
  receivedAt   DateTime  @default(now())
}

model Newsletter {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  whatsappOptIn Boolean  @default(false)
  subscribedAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  userEmail       String
  user            User        @relation(fields: [userEmail], references: [email])
  amount          Float
  amountPaise     Int
  paymentId       String?
  razorpayOrderId String?
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Initiative {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  imageUrl    String?
  stats       String?
  order       Int     @default(0)
  isActive    Boolean @default(true)
}

model Testimonial {
  id           String  @id @default(cuid())
  name         String
  designation  String
  organization String?
  photoUrl     String?
  quote        String
  videoUrl     String?
  isActive     Boolean @default(true)
  order        Int     @default(0)
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}


model PopupBanner {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
