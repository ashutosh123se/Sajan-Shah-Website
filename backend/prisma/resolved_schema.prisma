generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  MEMBER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String?
  passwordSetupToken   String?   @unique
  passwordSetupExpires DateTime?
  role                 UserRole  @default(CUSTOMER)
  photoUrl             String?
  phone                String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  orders               Order[]
}

model Product {
  id                 String      @id @default(cuid())
  name               String      @default("")
  slug               String      @unique
  category           String      // book | course | merchandise
  description        String      @db.Text
  short_description  String?     @db.Text
  is_active          Boolean     @default(true)
  is_featured        Boolean     @default(false)
  featured_order     Int?
  image_homepage     String?     
  image_product_page String?     
  buy_url_amazon     String?     
  buy_url_flipkart   String?     
  buy_url_internal   String?     
  price              Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
  orderItems         OrderItem[]
}

model Event {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique @default("")
  description        String?  @db.Text
  posterUrl          String
  homepageImageUrl   String?
  webinarUrl         String
  eventDate          DateTime
  city               String?
  venue              String?
  eventType          String?  // school | corporate | public | online
  isPast             Boolean  @default(false)
  isFree             Boolean  @default(true)
  price              Float?
  capacity           Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Member {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  photoUrl           String
  bio                String   @db.Text
  tier               String   // Gold | Silver | Community
  joinedAt           DateTime @default(now())
}

model MemberApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  bio       String   @db.Text
  whyJoin   String   @db.Text
  status    String   @default("PENDING")
  appliedAt DateTime @default(now())
}

model Contributor {
  id                 String @id @default(cuid())
  name               String
  photoUrl           String
  role               String
  description        String @db.Text
  order              Int    @default(0)
}

model SpeakingPageSection {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero', 'logos', 'message', 'reasons', 'catalog', 'features'
  title     String?
  content   Json?      // Stores structured data for that specific section
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Contact {
  id           String    @id @default(cuid())
  name         String
  organization String?
  email        String
  phone        String?
  city         String?
  eventType    String?
  eventDate    DateTime?
  audience     String?
  message      String    @db.Text
  formType     String    @default("inquiry")
  isRead       Boolean   @default(false)
  receivedAt   DateTime  @default(now())
}

model Newsletter {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  whatsappOptIn Boolean  @default(false)
  subscribedAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  userEmail       String
  user            User        @relation(fields: [userEmail], references: [email])
  amount          Float
  amountPaise     Int
  paymentId       String?
  razorpayOrderId String?
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("RAZORPAY")
  trackingId      String?
  shippingNotes   String?   @db.Text
  shippingAddress String?   @db.Text
  phone           String?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Initiative {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String  @db.Text
  imageUrl    String?
  stats       String?
  order       Int     @default(0)
  isActive    Boolean @default(true)
}

model Testimonial {
  id           String  @id @default(cuid())
  name         String
  designation  String
  organization String?
  photoUrl     String?
  quote        String  @db.Text
  videoUrl     String?
  isActive     Boolean @default(true)
  order        Int     @default(0)
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model PopupBanner {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String   // website, smtp, payment, social
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  source    String?  // e.g., 'contact-form', 'newsletter', 'masterclass-funnel'
  data      Json?      // to store additional fields like message, subject, organization, etc.
  status    String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CLOSED
  createdAt DateTime @default(now())
}

model AboutPageSection {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero', 'mission', 'bio', etc.
  title     String?
  content   Json?      // Stores the structured data for that specific section
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EventsPageSection {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero', 'cta'
  title     String?
  content   Json?      // Stores the structured data for that specific section
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model ContributionsPageSection {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero', 'donate', etc.
  title     String?
  content   Json?      // Stores the structured data for that specific section
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model HomePageSection {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero', 'split_hero', 'brand_writeup'
  title     String?
  content   Json?      // Stores the structured data for that specific section
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PressArticle {
  id        String   @id @default(cuid())
  title     String
  url       String
  source    String
  imageUrl  String?
  date      DateTime
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
